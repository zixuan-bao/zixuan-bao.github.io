{
  "name": "zixuanb3-personal-site",
  "private": true,
  "version": "1.0.0",
  "description": "A personal website built with Hugo and the Paige theme.",
  "scripts": {
    "dev": "node scripts/hugo.mjs server --bind 127.0.0.1 --port 1313 --disableFastRender",
    "build": "node scripts/hugo.mjs --environment production --minify",
    "check": "node scripts/verify.mjs",
    "editor": "node scripts/start-editor.mjs",
    "publish": "node scripts/publish.mjs",
    "test": "node --test scripts/editor-model.test.mjs"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "yaml": "2.9.1"
  }
}
